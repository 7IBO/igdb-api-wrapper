{
  "name": "igdb-kit",
  "version": "0.0.0",
  "description": "Fully typed IGDB API client for Node.js and Bun: exact result types, shared rate limit, automatic multiquery batching.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "igdb",
    "igdb-api",
    "twitch",
    "games",
    "apicalypse",
    "typescript"
  ],
  "scripts": {
    "build": "bun --bun tsdown",
    "codegen": "bun scripts/codegen.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:types": "tsc --noEmit -p test/types",
    "bench:types": "bun scripts/bench-types.ts",
    "lint:package": "publint && rm -rf .pack && bun pm pack --quiet --destination .pack && attw .pack/*.tgz --profile node16"
  },
  "devDependencies": {
    "tsdown": "0.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7IBO/igdb-api-wrapper.git",
    "directory": "packages/igdb-kit"
  }
}
