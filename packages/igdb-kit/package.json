{
  "name": "igdb-kit",
  "version": "0.6.0",
  "description": "Fully typed IGDB API client for Node.js and Bun: result types inferred from selected fields, typed filters, automatic multiquery batching, shared rate limit and token renewal.",
  "license": "MIT",
  "author": "7IBO",
  "homepage": "https://github.com/7IBO/igdb-kit/tree/main/packages/igdb-kit#readme",
  "bugs": {
    "url": "https://github.com/7IBO/igdb-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./redis": {
      "import": {
        "types": "./dist/redis.d.ts",
        "default": "./dist/redis.js"
      },
      "require": {
        "types": "./dist/redis.d.cts",
        "default": "./dist/redis.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./proxy": {
      "import": {
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.js"
      },
      "require": {
        "types": "./dist/proxy.d.cts",
        "default": "./dist/proxy.cjs"
      }
    },
    "./game": {
      "import": {
        "types": "./dist/game.d.ts",
        "default": "./dist/game.js"
      },
      "require": {
        "types": "./dist/game.d.cts",
        "default": "./dist/game.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n.d.ts",
        "default": "./dist/i18n.js"
      },
      "require": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      }
    },
    "./i18n/fr": {
      "import": {
        "types": "./dist/i18n/fr.d.ts",
        "default": "./dist/i18n/fr.js"
      },
      "require": {
        "types": "./dist/i18n/fr.d.cts",
        "default": "./dist/i18n/fr.cjs"
      }
    },
    "./i18n/de": {
      "import": {
        "types": "./dist/i18n/de.d.ts",
        "default": "./dist/i18n/de.js"
      },
      "require": {
        "types": "./dist/i18n/de.d.cts",
        "default": "./dist/i18n/de.cjs"
      }
    },
    "./i18n/es": {
      "import": {
        "types": "./dist/i18n/es.d.ts",
        "default": "./dist/i18n/es.js"
      },
      "require": {
        "types": "./dist/i18n/es.d.cts",
        "default": "./dist/i18n/es.cjs"
      }
    },
    "./i18n/pt-BR": {
      "import": {
        "types": "./dist/i18n/pt-BR.d.ts",
        "default": "./dist/i18n/pt-BR.js"
      },
      "require": {
        "types": "./dist/i18n/pt-BR.d.cts",
        "default": "./dist/i18n/pt-BR.cjs"
      }
    },
    "./i18n/pl": {
      "import": {
        "types": "./dist/i18n/pl.d.ts",
        "default": "./dist/i18n/pl.js"
      },
      "require": {
        "types": "./dist/i18n/pl.d.cts",
        "default": "./dist/i18n/pl.cjs"
      }
    },
    "./i18n/ru": {
      "import": {
        "types": "./dist/i18n/ru.d.ts",
        "default": "./dist/i18n/ru.js"
      },
      "require": {
        "types": "./dist/i18n/ru.d.cts",
        "default": "./dist/i18n/ru.cjs"
      }
    },
    "./i18n/ja": {
      "import": {
        "types": "./dist/i18n/ja.d.ts",
        "default": "./dist/i18n/ja.js"
      },
      "require": {
        "types": "./dist/i18n/ja.d.cts",
        "default": "./dist/i18n/ja.cjs"
      }
    },
    "./i18n/zh-CN": {
      "import": {
        "types": "./dist/i18n/zh-CN.d.ts",
        "default": "./dist/i18n/zh-CN.js"
      },
      "require": {
        "types": "./dist/i18n/zh-CN.d.cts",
        "default": "./dist/i18n/zh-CN.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "igdb",
    "igdb-api",
    "twitch",
    "games",
    "apicalypse",
    "typescript"
  ],
  "scripts": {
    "build": "bun --bun tsdown",
    "codegen": "bun scripts/codegen.ts",
    "audit": "bun scripts/audit-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:redis": "bun test test/redis",
    "test:types": "tsc --noEmit -p test/types",
    "bench:types": "bun scripts/bench-types.ts",
    "lint:package": "publint && rm -rf .pack && bun pm pack --quiet --destination .pack && attw .pack/*.tgz --profile node16",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "ioredis": "6.0.0",
    "redis": "6.3.0",
    "tsdown": "0.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7IBO/igdb-kit.git",
    "directory": "packages/igdb-kit"
  },
  "publishConfig": {
    "access": "public"
  }
}
